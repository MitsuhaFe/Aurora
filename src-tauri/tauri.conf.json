{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "devPath": "http://localhost:5173",
    "distDir": "../dist",
    "withGlobalTauri": false
  },
  "package": {
    "productName": "Aurora",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true,
        "execute": true,
        "sidecar": true,
        "scope": [
          {
            "name": "bin/AuroraCore",
            "sidecar": true,
            "args": true
          },
          {
            "name": "cmd",
            "cmd": "cmd",
            "args": [
              "/c",
              "start",
              "",
              {
                "validator": ".*"
              }
            ]
          },
          {
            "name": "explorer",
            "cmd": "explorer",
            "args": true
          },
          {
            "name": "control",
            "cmd": "control",
            "args": true
          }
        ]
      },
      "window": {
        "all": true,
        "create": true,
        "center": true,
        "close": true,
        "hide": true,
        "maximize": true,
        "minimize": true,
        "show": true,
        "setAlwaysOnTop": true,
        "setDecorations": true,
        "setPosition": true,
        "setSize": true,
        "setSkipTaskbar": true,
        "setTitle": true,
        "startDragging": true
      },
      "fs": {
        "all": true,
        "scope": ["**"]
      },
      "dialog": {
        "all": true,
        "open": true,
        "save": true
      },
      "path": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.aurora.desktop",
      "icon": [
        "icons/icon.ico"
      ],
      "externalBin": ["bin/AuroraCore"],
      "resources": []
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Aurora",
        "width": 900,
        "height": 650,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": true,
        "center": true,
        "minWidth": 800,
        "minHeight": 600
      }
    ]
  }
}

